#!/usr/bin/env python3
"""Generate the LiteLLM config from Home Assistant options and start it."""

import json
import os
from pathlib import Path
import sys
import tempfile

import httpx
import yaml


DATA_DIR = Path("/data")
OPTIONS_PATH = DATA_DIR / "options.json"
CONFIG_PATH = DATA_DIR / "litellm-config.yaml"
OAUTH_GRACE_PATH = DATA_DIR / ".oauth-startup-grace"
PORT = 4000
COPILOT_PROVIDER_PREFIX = "github_copilot/"
COPILOT_ENVIRONMENT_VARIABLES = {
    "GITHUB_COPILOT_ACCESS_TOKEN_URL",
    "GITHUB_COPILOT_API_BASE",
    "GITHUB_COPILOT_API_KEY_URL",
    "GITHUB_COPILOT_CLIENT_ID",
    "GITHUB_COPILOT_DEVICE_CODE_URL",
}
RESERVED_ENVIRONMENT_VARIABLES = {
    "CHATGPT_AUTH_FILE",
    "CHATGPT_TOKEN_DIR",
    "CONFIG_FILE_PATH",
    "GITHUB_COPILOT_ACCESS_TOKEN_FILE",
    "GITHUB_COPILOT_API_KEY_FILE",
    "GITHUB_COPILOT_TOKEN_DIR",
    "HOME",
    "LITELLM_LOG",
    "LITELLM_MASTER_KEY",
    "LITELLM_MODE",
    "LITELLM_SALT_KEY",
    "XDG_CACHE_HOME",
}


def fail(message: str) -> None:
    print(f"Configuration error: {message}", file=sys.stderr)
    raise SystemExit(1)


def load_options() -> dict:
    try:
        options = json.loads(OPTIONS_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read {OPTIONS_PATH}: {error}")
    if not isinstance(options, dict):
        fail("options.json must contain an object")
    return options


def build_config(options: dict) -> dict:
    master_key = options.get("master_key")
    if not isinstance(master_key, str) or not master_key:
        fail("master_key is required")
    if not master_key.startswith("sk-") or len(master_key) < 19:
        fail("master_key must start with 'sk-' and contain at least 16 more characters")

    raw_config = options.get("litellm_config", "")
    if not isinstance(raw_config, str):
        fail("litellm_config must be YAML text")
    try:
        config = yaml.safe_load(raw_config) if raw_config.strip() else {}
    except yaml.YAMLError as error:
        mark = getattr(error, "problem_mark", None)
        location = f" near line {mark.line + 1}, column {mark.column + 1}" if mark else ""
        fail(f"litellm_config is not valid YAML{location}")
    if not isinstance(config, dict):
        fail("litellm_config must contain a YAML mapping")

    general_settings = config.setdefault("general_settings", {})
    if not isinstance(general_settings, dict):
        fail("general_settings must be a YAML mapping")
    general_settings["master_key"] = "os.environ/LITELLM_MASTER_KEY"

    environment_variables = config.get("environment_variables", {})
    if not isinstance(environment_variables, dict):
        fail("environment_variables must be a YAML mapping")
    if RESERVED_ENVIRONMENT_VARIABLES.intersection(environment_variables):
        fail("environment_variables contains a setting managed by the add-on")
    for name in COPILOT_ENVIRONMENT_VARIABLES.intersection(environment_variables):
        value = environment_variables[name]
        if isinstance(value, str):
            os.environ[name] = value

    os.environ["LITELLM_MASTER_KEY"] = master_key
    log_level = options.get("log_level", "info")
    if log_level not in {"debug", "info", "warning", "error", "critical"}:
        fail("log_level is invalid")
    os.environ["LITELLM_LOG"] = log_level.upper()

    salt_key = options.get("salt_key", "")
    if salt_key:
        if not isinstance(salt_key, str):
            fail("salt_key must be a string")
        os.environ["LITELLM_SALT_KEY"] = salt_key

    return config


def discover_github_copilot_models(config: dict) -> None:
    model_list = config.get("model_list", [])
    if not isinstance(model_list, list):
        return

    discovery_indexes = []
    for index, deployment in enumerate(model_list):
        if not isinstance(deployment, dict):
            continue
        params = deployment.get("litellm_params", {})
        if not isinstance(params, dict):
            continue
        configured_model = str(params.get("model", ""))
        if configured_model == "github_copilot/*" or (
            configured_model == "github_copilot/gpt-5.2"
            and deployment.get("model_name") == configured_model
        ):
            discovery_indexes.append(index)

    if not discovery_indexes:
        return

    catalog_path = DATA_DIR / ".config" / "litellm" / "github_copilot" / "models.json"
    try:
        from litellm.llms.github_copilot.authenticator import Authenticator
        from litellm.llms.github_copilot.common_utils import (
            DEFAULT_GITHUB_COPILOT_API_BASE,
        )

        authenticator = Authenticator()
        authenticator.get_api_key()
        access_token = authenticator.get_access_token()
        api_base = (
            authenticator.get_api_base()
            or os.getenv("GITHUB_COPILOT_API_BASE")
            or DEFAULT_GITHUB_COPILOT_API_BASE
        ).rstrip("/")
        response = httpx.get(
            f"{api_base}/models",
            headers={
                "Authorization": f"Bearer {access_token}",
                "User-Agent": "LiteLLM Home Assistant Add-on",
                "X-GitHub-Api-Version": "2026-06-01",
            },
            timeout=10,
        )
        response.raise_for_status()
        catalog_response = response.json()
        catalog = catalog_response.get("data", [])
        catalog_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        catalog_path.write_text(json.dumps(catalog_response), encoding="utf-8")
        catalog_path.chmod(0o600)
    except Exception as error:
        try:
            catalog = json.loads(catalog_path.read_text(encoding="utf-8")).get(
                "data", []
            )
        except (OSError, json.JSONDecodeError, AttributeError):
            fail(f"cannot discover GitHub Copilot models: {error}")
        print(
            f"Warning: cannot refresh GitHub Copilot models; using cached catalog: {error}",
            file=sys.stderr,
        )

    discovered = []
    for model in catalog:
        if not isinstance(model, dict):
            continue
        model_id = model.get("id")
        endpoints = model.get("supported_endpoints", [])
        policy = model.get("policy")
        policy_state = policy.get("state") if isinstance(policy, dict) else None
        supports_responses = isinstance(endpoints, list) and any(
            endpoint in {"/responses", "/v1/responses"} for endpoint in endpoints
        )
        supports_chat = isinstance(endpoints, list) and any(
            endpoint in {"/chat/completions", "/v1/chat/completions"}
            for endpoint in endpoints
        )
        if (
            isinstance(model_id, str)
            and model.get("model_picker_enabled", False)
            and policy_state != "disabled"
            and (supports_responses or supports_chat)
        ):
            full_model_name = f"{COPILOT_PROVIDER_PREFIX}{model_id}"
            deployment = {
                "model_name": full_model_name,
                "litellm_params": {"model": full_model_name},
            }
            if supports_responses:
                deployment["model_info"] = {"mode": "responses"}
            discovered.append(deployment)

    if not discovered:
        fail("GitHub Copilot did not return any enabled compatible models")

    first_index = discovery_indexes[0]
    model_list[:] = [
        deployment
        for index, deployment in enumerate(model_list)
        if index not in discovery_indexes
    ]
    for deployment in reversed(discovered):
        model_list.insert(first_index, deployment)
    print(
        "Discovered GitHub Copilot models: "
        + ", ".join(model["model_name"] for model in discovered)
    )


def write_config(config: dict) -> None:
    DATA_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    (DATA_DIR / "chatgpt").mkdir(mode=0o700, exist_ok=True)
    (DATA_DIR / ".config" / "litellm" / "github_copilot").mkdir(
        mode=0o700, parents=True, exist_ok=True
    )
    (DATA_DIR / ".cache").mkdir(mode=0o700, exist_ok=True)

    descriptor, temporary_name = tempfile.mkstemp(
        dir=DATA_DIR, prefix=".litellm-config-", text=True
    )
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as temporary_file:
            yaml.safe_dump(config, temporary_file, sort_keys=False)
            temporary_file.flush()
            os.fsync(temporary_file.fileno())
        os.replace(temporary_name, CONFIG_PATH)
    except BaseException:
        Path(temporary_name).unlink(missing_ok=True)
        raise


def prepare_oauth_health_grace(config: dict) -> None:
    model_list = config.get("model_list", [])
    uses_oauth = any(
        isinstance(model, dict)
        and isinstance(model.get("litellm_params"), dict)
        and str(model["litellm_params"].get("model", "")).startswith(
            ("chatgpt/", COPILOT_PROVIDER_PREFIX)
        )
        for model in model_list
    ) if isinstance(model_list, list) else False

    if uses_oauth:
        OAUTH_GRACE_PATH.touch(mode=0o600)
    else:
        OAUTH_GRACE_PATH.unlink(missing_ok=True)


def main() -> None:
    # LiteLLM creates OAuth token files after startup; keep them owner-only.
    os.umask(0o077)
    os.environ["CHATGPT_TOKEN_DIR"] = str(DATA_DIR / "chatgpt")
    os.environ["CHATGPT_AUTH_FILE"] = "auth.json"
    os.environ["GITHUB_COPILOT_TOKEN_DIR"] = str(
        DATA_DIR / ".config" / "litellm" / "github_copilot"
    )
    os.environ["GITHUB_COPILOT_ACCESS_TOKEN_FILE"] = "access-token"
    os.environ["GITHUB_COPILOT_API_KEY_FILE"] = "api-key.json"
    config = build_config(load_options())
    prepare_oauth_health_grace(config)
    discover_github_copilot_models(config)
    write_config(config)
    print(f"Starting LiteLLM on port {PORT}")
    arguments = [
        "litellm",
        "--config",
        str(CONFIG_PATH),
        "--port",
        str(PORT),
        "--num_workers",
        "1",
    ]
    os.execvpe(arguments[0], arguments, os.environ)


if __name__ == "__main__":
    main()
